# ==============================================================================
# LIFE RESUME — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), set these in your hosting environment settings.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Database (e.g., Supabase, Neon, AWS RDS, self-hosted PostgreSQL)
# Connection pooling URL (port 6543 on Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL for migrations (port 5432 on Supabase)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication & Cryptographic Session Security
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-jwt-and-cookie-signing-key-min-32-chars"
JWT_SECRET="your-jwt-verification-token-secret-min-32-chars"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role key MUST NOT be exposed in NEXT_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET_PRIVATE="evidence-vault-private"
SUPABASE_STORAGE_BUCKET_PUBLIC="public-avatars"

# Resend Email Integration (Transactional verification & notification emails)
RESEND_API_KEY="re_1234567890abcdef"
EMAIL_FROM="Life Resume <notifications@liferesume.com>"

# AI Engine Integration (Server-side LLM for achievement analysis & resume generation)
# Supports Gemini, OpenAI, or Anthropic. All calls are strictly server-side.
AI_PROVIDER="gemini" # Options: gemini | openai | anthropic
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"
AUDIT_LOG_ENABLED="true"
ENABLE_DATA_PROTECTION_DPDP="true"
